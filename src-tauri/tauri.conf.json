{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Sora POS",
  "version": "0.1.0",
  "identifier": "id.sora.pos",
  "build": {
    "frontendDist": "../desktop/splash",
    "beforeBuildCommand": "node desktop/prepare.mjs"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Sora POS",
        "width": 1366,
        "height": 820,
        "minWidth": 1024,
        "minHeight": 640,
        "maximized": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "externalBin": ["binaries/node"],
    "resources": {
      "../desktop/dist/app/": "app/"
    },
    "windows": {
      "webviewInstallMode": { "type": "embedBootstrapper" }
    }
  }
}
